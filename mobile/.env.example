# ─────────────────────────────────────────────────────────────────
# The Black Wash — Mobile App Environment Variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Backend API base URL
# Android Emulator (Default): http://10.0.2.2:8011/api/
# iOS Simulator / Web:       http://localhost:8011/api/
# Physical Device (LAN IP):   http://192.168.1.X:8011/api/
# Production:                https://api.theblackwash.com/api/
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8011/api/

# App environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Business contact (WhatsApp and Phone — public, non-sensitive)
EXPO_PUBLIC_CALL_NUMBER=+916201030273
EXPO_PUBLIC_WHATSAPP_NUMBER=+916201030273

# Legal & Policy website URL (Vercel deployment)
EXPO_PUBLIC_LEGAL_SITE_URL=https://theblackwash.vercel.app

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Web / Android / iOS Client IDs
EXPO_PUBLIC_GOOGLE_CLIENT_ID=347851166673-o863kj6gje7hde5rq8fgqe8i145eiv12.apps.googleusercontent.com

# Dev-only: show home screen without auth (MUST be false in production)
EXPO_PUBLIC_DEV_HOME_PREVIEW=false
