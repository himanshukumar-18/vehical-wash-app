# ─────────────────────────────────────────────────────────────────
# The Black Wash — Mobile App Environment Variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Backend API base URL
# iOS Simulator: http://localhost:8000/api/
# Android Emulator: http://10.0.2.2:8000/api/
# Production: https://api.theblackwash.com/api/
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/

# App environment (development | staging | production)
# Values: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Optional WhatsApp Business Support Number (overrides default fallback)
# EXPO_PUBLIC_WHATSAPP_NUMBER=+917004050123

# Development-Only Home Preview Flag
# Set to 'true' to jump straight to the Home screen for rapid UI preview in Expo Go
# without logging in every time. Only active when __DEV__ is true.
# Values: true | false (default: false)
EXPO_PUBLIC_DEV_HOME_PREVIEW=true
