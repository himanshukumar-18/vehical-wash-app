# Application Settings
DEBUG=True
SECRET_KEY=django-insecure-the-black-wash-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings (PostgreSQL 17)
DB_NAME=theblackwash
DB_USER=theblackwash_user
DB_PASSWORD=theblackwash_password
DB_HOST=db
DB_PORT=5432

# Port Configuration (Host 8011 -> Container 8000)
HOST_PORT=8011
CONTAINER_PORT=8000

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=The Black Wash <noreply@theblackwash.com>

# SMS Provider Settings (MSG91)
SMS_PROVIDER=mock
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=TBWASH

# Google Authentication
GOOGLE_CLIENT_ID=