# =============================================================================
# THE BLACK WASH — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with production credentials.
# NEVER commit the actual .env file or real secrets to git repository.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DJANGO CORE SETTINGS
# -----------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,theblackwash.com,api.theblackwash.com

# -----------------------------------------------------------------------------
# 2. CORS & FRONTEND ORIGINS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://theblackwash.com

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (POSTGRESQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=wash_db
POSTGRES_USER=wash_user
POSTGRES_PASSWORD=change_this_postgres_password_in_prod
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://wash_user:change_this_postgres_password_in_prod@db:5432/wash_db

# -----------------------------------------------------------------------------
# 4. REDIS & CELERY (FOR ASYNC TASKS / NOTIFICATIONS)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY (PROD / TEST KEYS)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -----------------------------------------------------------------------------
# 6. CLOUDINARY MEDIA STORAGE (FOR DYNAMIC IMAGES)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# 7. EMAIL & SMTP SETTINGS (FOR OTP & NOTIFICATIONS)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_official_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password_here
DEFAULT_FROM_EMAIL="The Black Wash" <your_official_email@gmail.com>

# -----------------------------------------------------------------------------
# 8. NEXT.JS FRONTEND ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
NEXT_PUBLIC_SITE_URL=https://theblackwash.com
